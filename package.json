{
	"name": "@appulsauce/svelte-grid",
	"version": "2.0.3",
	"description": "A draggable and resizable grid layout, for Svelte 5",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KaiErikNiermann/svelte-grid-extended.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm package",
		"package:build": "svelte-kit sync && svelte-package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm package",
		"test": "svelte-kit sync && vitest",
		"test:unit": "svelte-kit sync && vitest run",
		"coverage": "svelte-kit sync && vitest run --coverage",
		"e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:docs": "pnpm package:build && pnpm --dir docs check",
		"lint": "prettier --check . && eslint . --max-warnings=0",
		"lint:fix": "prettier --write . && eslint . --fix",
		"format": "prettier --write .",
		"verify": "pnpm lint && pnpm check && pnpm test:unit",
		"prepare": "husky",
		"docs:dev": "pnpm --dir docs dev",
		"docs:build": "pnpm --dir docs build",
		"docs:preview": "pnpm --dir docs preview",
		"docs:install": "pnpm --dir docs install"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"keywords": [
		"svelte",
		"svelte5",
		"grid",
		"drag",
		"draggable",
		"resize",
		"resizable",
		"fluid",
		"responsive"
	],
	"author": "cuire <garwes@icloud.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/KaiErikNiermann/svelte-grid-extended/issues"
	},
	"homepage": "https://github.com/KaiErikNiermann/svelte-grid-extended#readme",
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.5.4",
		"daisyui": "^4.12.24",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-security": "^4.0.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-svelte": "^2.46.1",
		"eslint-plugin-unicorn": "^62.0.0",
		"globals": "^15.15.0",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"lint-staged": "^17.3.0",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.2.12",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^6.4.3",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"packageManager": "pnpm@9.15.0",
	"lint-staged": {
		"*.{js,ts,svelte,md,svx,json,css,yaml,yml}": "prettier --write",
		"*.{js,ts,svelte}": "eslint --fix --max-warnings=0"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2"
		}
	}
}
