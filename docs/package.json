		"clsx": "^2.1.1",
		"lucide-svelte": "^0.469.0",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.3.2",
		"rehype-slug": "^6.0.0",
		"shiki": "^1.27.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwind-merge": "^2.6.0",
		"tailwindcss": "^3.4.17",
