		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/hast": "^3.0.5",
		"@types/node": "^22.20.5",
		"autoprefixer": "^10.5.4",
		"bits-ui": "^1.0.0-next.80",
		"clsx": "^2.1.1",
		"lucide-svelte": "^0.469.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-to-hast": "^13.2.1",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.3.2",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^2.6.0",
		"tailwindcss": "^3.4.17",
		"ts-pattern": "^5.6.0",
		"tslib": "^2.8.1",
		"twoslash": "^0.3.9",
		"twoslash-protocol": "0.3.9",
		"twoslash-svelte": "^0.3.9",
		"typescript": "^6.0.3",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"@appulsauce/svelte-grid": "link:.."
	},
	"type": "module",
	"packageManager": "pnpm@9.15.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
